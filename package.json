{
    "dependencies": {
        "express": "^4.21.0",
        "node-cron": "^3.0.3",
        "puppeteer": "^23.4.1",
        "puppeteer-core": "^23.4.1",
        "winston": "^3.14.2"
    },
    "scripts": {
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "build:clean": "rm -rf dist && tsc",
        "build": "tsc",
        "start": "node dist/src/main.js",
        "start:build": "rm -rf dist && tsc && node dist/src/main.js",
        "start:zoom": "rm -rf dist && tsc && node dist/scripts/runZoomBot.js",
        "start:odin": "rm -rf dist && tsc && node dist/scripts/odinOnlineBot.js",
        "start:hh": "rm -rf dist && tsc && node dist/scripts/hhBot.js"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.13",
        "@types/node": "^22.7.3",
        "@types/node-cron": "^3.0.11",
        "@typescript-eslint/eslint-plugin": "^8.7.0",
        "@typescript-eslint/parser": "^8.7.0",
        "dotenv": "^16.4.5",
        "eslint": "^9.11.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.2"
    }
}
